{
  "name": "promptpay",
  "version": "0.0.1",
  "private": true,
  "description": "PromptPay to QR Code",
  "author": "Karn Wong <karn@karnwong.me>",
  "type": "module",
  "scripts": {
    "lint": "oxlint ./src ./src-pwa",
    "format": "oxfmt --write \"**/*.{js,ts,vue,scss,html,md,json}\"",
    "format:check": "oxfmt --check \"**/*.{js,ts,vue,scss,html,md,json}\"",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev -m pwa",
    "build": "quasar build -m pwa",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.0",
    "promptpay-qr": "^0.5.0",
    "qrcode.vue": "^3.6.0",
    "quasar": "^2.16.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.4.18",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.0.0",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.4.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~7.0.0",
    "vite-plugin-checker": "^0.14.0",
    "vue-tsc": "^3.0.0",
    "workbox-build": "^7.0.0",
    "workbox-cacheable-response": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "productName": "PromptPay QR Code"
}
